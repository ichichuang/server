{
  "name": "ccd-server",
  "version": "1.0.0",
  "description": "CCD demo API server based on Hono",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --outDir dist",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "vercel-build": "pnpm build"
  },
  "keywords": [
    "hono",
    "api",
    "server",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.7.5",
    "hono": "^4.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
